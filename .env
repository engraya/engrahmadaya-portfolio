# https://resend.com — contact form (optional; without it, users see an error and can use mailto)
RESEND_API_KEY=

# Verified sender in Resend (defaults to onboarding@resend.dev for testing)
RESEND_FROM_EMAIL=

# Where contact messages are delivered (defaults to engrahmadaya@gmail.com)
RESEND_TO_EMAIL=

# Canonical site URL for Open Graph and sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://localhost:3000